def solution(s):

    answer = 0
    p = {
        ']': '[',
        '}': '{',
        ')': '('
    }

    for i in range(len(s)):
        stck = []
        valid = True



        rotated_s = s[i:] + s[:i]
        for c in rotated_s:
            if c in '({[':
                stck.append(c)
            elif len(stck) == 0:
                valid = False
                break
            elif stck[-1] == p[c]:
                stck.pop()
            elif stck[-1] != p[c]:
                valid = False
                break
        if valid and len(stck) == 0:
            answer += 1

    return answer
